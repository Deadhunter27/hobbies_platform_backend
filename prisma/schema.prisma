generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum HobbyDifficulty {
  beginner_friendly
  moderate
  demanding

  @@map("hobby_difficulty")
}

enum HobbyCostLevel {
  free
  low
  medium
  high

  @@map("hobby_cost_level")
}

enum HobbySetting {
  indoor
  outdoor
  both

  @@map("hobby_setting")
}

enum HobbyStatus {
  draft
  active
  archived

  @@map("hobby_status")
}

enum UserStatus {
  active
  suspended
  deleted

  @@map("user_status")
}

enum GlobalRole {
  user
  staff

  @@map("global_role")
}

enum ProfileExperienceLevel {
  exploring
  beginner
  returning
  regular
  experienced

  @@map("profile_experience_level")
}

enum ProfileIntent {
  start
  improve
  social
  explore

  @@map("profile_intent")
}

enum ProfileSocialPreference {
  solo
  mixed
  social

  @@map("profile_social_preference")
}

enum ActivityEffortLevel {
  easy
  moderate
  challenging
  open

  @@map("activity_effort_level")
}

enum ActivityStatus {
  draft
  published
  cancelled
  completed

  @@map("activity_status")
}

enum ActivityCommitmentState {
  interested
  committed
  cancelled
  missed
  completed

  @@map("activity_commitment_state")
}

enum RecommendationStatus {
  active
  rejected
  superseded
  selected

  @@map("recommendation_status")
}

enum RecommendationRejectionReason {
  timing
  too_difficult
  prefer_solo
  learn_first
  social_comfort
  other

  @@map("recommendation_rejection_reason")
}

enum CommunityStatus {
  draft
  published
  archived

  @@map("community_status")
}

enum CommunityMembershipRole {
  member
  host
  organizer

  @@map("community_membership_role")
}

enum CommunityMembershipState {
  active
  left

  @@map("community_membership_state")
}

enum CheckInKind {
  activity_reminder
  post_activity
  missed_plan

  @@map("check_in_kind")
}

enum CheckInStatus {
  pending
  actioned
  dismissed

  @@map("check_in_status")
}

// ADR-0017: user aggregate. Email is stored lowercase (normalized at the
// boundary); uniqueness on the normalized form is case-insensitive.
model IdentityUser {
  id           String            @id @db.Char(26)
  email        String            @unique @db.VarChar(320)
  passwordHash String            @db.VarChar(255)
  displayName  String            @db.VarChar(120)
  status       UserStatus        @default(active)
  globalRole   GlobalRole        @default(user)
  sessions     IdentitySession[]
  createdAt    DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime          @updatedAt @db.Timestamptz(3)

  @@map("identity_user")
}

// ADR-0017: sessions are their own aggregate. familyId groups rotation
// chains; reuse of a rotated token revokes the whole family.
model IdentitySession {
  id               String       @id @db.Char(26)
  userId           String       @db.Char(26)
  user             IdentityUser @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  refreshTokenHash String       @unique @db.Char(64)
  familyId         String       @db.Char(26)
  deviceLabel      String?      @db.VarChar(120)
  expiresAt        DateTime     @db.Timestamptz(3)
  revokedAt        DateTime?    @db.Timestamptz(3)
  replacedById     String?      @db.Char(26)
  createdAt        DateTime     @default(now()) @db.Timestamptz(3)

  @@index([userId])
  @@index([familyId])
  @@map("identity_session")
}

// ADR-0018: relationship-scoped grants. Platform scope uses
// resourceType='platform', resourceId='platform'. One role per user per
// resource.
model AccessResourceRole {
  id           String   @id @db.Char(26)
  userId       String   @db.Char(26)
  resourceType String   @db.VarChar(40)
  resourceId   String   @db.VarChar(40)
  role         String   @db.VarChar(40)
  createdAt    DateTime @default(now()) @db.Timestamptz(3)

  @@unique([userId, resourceType, resourceId])
  @@map("access_resource_role")
}

// ADR-0019: append-only audit trail. No update/delete code path exists.
model AuditEntry {
  id           String   @id @db.Char(26)
  actorId      String?  @db.Char(26)
  action       String   @db.VarChar(80)
  resourceType String   @db.VarChar(40)
  resourceId   String?  @db.VarChar(40)
  metadata     Json     @default("{}")
  requestId    String?  @db.VarChar(80)
  createdAt    DateTime @default(now()) @db.Timestamptz(3)

  @@index([resourceType, resourceId, createdAt])
  @@map("audit_entry")
}

// ADR-0016: hierarchical hobby taxonomy. Categories carry no status/facets —
// only hobbies are filterable/facet-bearing.
model CatalogHobbyCategory {
  id          String                 @id @db.Char(26)
  parentId    String?                @db.Char(26)
  parent      CatalogHobbyCategory?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  children    CatalogHobbyCategory[] @relation("CategoryHierarchy")
  name        String                 @db.VarChar(120)
  slug        String                 @unique @db.VarChar(140)
  description String?                @db.Text
  sortOrder   Int                    @default(0)
  hobbies     CatalogHobby[]
  createdAt   DateTime               @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime               @updatedAt @db.Timestamptz(3)

  @@index([parentId])
  @@index([sortOrder, id])
  @@map("catalog_hobby_category")
}

model CatalogHobby {
  id          String               @id @db.Char(26)
  categoryId  String               @db.Char(26)
  category    CatalogHobbyCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  name        String               @db.VarChar(120)
  slug        String               @unique @db.VarChar(140)
  description String?              @db.Text
  difficulty  HobbyDifficulty
  costLevel   HobbyCostLevel
  setting     HobbySetting
  status      HobbyStatus          @default(draft)
  createdAt   DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime             @updatedAt @db.Timestamptz(3)

  @@index([status, name, id])
  @@index([categoryId, status])
  @@index([difficulty])
  @@index([costLevel])
  @@index([setting])
  @@map("catalog_hobby")
}

// ADR-0020: private, lightweight product context. Cross-context user ownership
// is enforced by authenticated application logic rather than a DB foreign key.
model ProfileUserContext {
  userId      String   @id @db.Char(26)
  city        String?  @db.VarChar(120)
  countryCode String?  @db.Char(2)
  timezone    String?  @db.VarChar(64)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  @@map("profile_user_context")
}

// ADR-0020: one evolving relationship/context record per user + hobby.
// userId/hobbyId are logical cross-context references, deliberately not DB FKs.
model ProfileHobbyContext {
  id               String                  @id @db.Char(26)
  userId           String                  @db.Char(26)
  hobbyId          String                  @db.Char(26)
  experienceLevel  ProfileExperienceLevel
  primaryIntent    ProfileIntent
  secondaryIntents ProfileIntent[]         @default([])
  goal             String?                 @db.VarChar(280)
  socialPreference ProfileSocialPreference @default(mixed)
  createdAt        DateTime                @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime                @updatedAt @db.Timestamptz(3)

  @@unique([userId, hobbyId])
  @@index([userId, updatedAt])
  @@map("profile_hobby_context")
}

// ADR-0021: a real-world opportunity. hobby/host/community references are logical
// cross-context references; only commitment has a same-context DB relation.
model Activity {
  id                   String               @id @db.Char(26)
  hobbyId              String               @db.Char(26)
  title                String               @db.VarChar(160)
  description          String?              @db.Text
  activityType         String               @db.VarChar(80)
  startsAt             DateTime             @db.Timestamptz(3)
  endsAt               DateTime?            @db.Timestamptz(3)
  timezone             String               @db.VarChar(64)
  placeName            String               @db.VarChar(160)
  addressLabel         String?              @db.VarChar(240)
  latitude             Float?               @db.DoublePrecision
  longitude            Float?               @db.DoublePrecision
  hostName             String?              @db.VarChar(160)
  hostType             String?              @db.VarChar(40)
  hostReferenceId      String?              @db.Char(26)
  communityReferenceId String?              @db.Char(26)
  effortLevel          ActivityEffortLevel
  capacity             Int?
  status               ActivityStatus       @default(draft)
  preparation          String               @db.Text
  expectations         String               @db.Text
  commitments          ActivityCommitment[]
  createdAt            DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime             @updatedAt @db.Timestamptz(3)

  @@index([status, startsAt, id])
  @@index([hobbyId, status, startsAt])
  @@map("activity")
}

model ActivityCommitment {
  id          String                  @id @db.Char(26)
  userId      String                  @db.Char(26)
  activityId  String                  @db.Char(26)
  activity    Activity                @relation(fields: [activityId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  state       ActivityCommitmentState
  committedAt DateTime?               @db.Timestamptz(3)
  cancelledAt DateTime?               @db.Timestamptz(3)
  missedAt    DateTime?               @db.Timestamptz(3)
  completedAt DateTime?               @db.Timestamptz(3)
  note        String?                 @db.VarChar(280)
  createdAt   DateTime                @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime                @updatedAt @db.Timestamptz(3)

  @@unique([userId, activityId])
  @@index([userId, updatedAt])
  @@index([activityId, state])
  @@map("activity_commitment")
}

// ADR-0022: durable directional decision state. Cross-context references are
// logical and intentionally do not use foreign keys to Profile/Activity tables.
model RecommendationDecision {
  id                 String                         @id @db.Char(26)
  userId             String                         @db.Char(26)
  hobbyId            String                         @db.Char(26)
  activityId         String                         @db.Char(26)
  title              String                         @db.VarChar(160)
  rationale          String                         @db.Text
  fitSignals         String[]                       @default([])
  intent             String                         @db.VarChar(40)
  status             RecommendationStatus           @default(active)
  rejectionReason    RecommendationRejectionReason?
  rejectionNote      String?                        @db.VarChar(280)
  selectedActivityId String?                        @db.Char(26)
  createdAt          DateTime                       @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime                       @updatedAt @db.Timestamptz(3)

  @@index([userId, hobbyId, status, updatedAt])
  @@index([activityId])
  @@index([selectedActivityId])
  @@map("recommendation_decision")
}

// W6: qualitative evidence that a real-world activity happened. Activity and
// hobby are logical cross-context references; one reflection per user/activity.
model ProgressReflection {
  id         String   @id @db.Char(26)
  userId     String   @db.Char(26)
  hobbyId    String   @db.Char(26)
  activityId String   @db.Char(26)
  rating     Int?
  tags       String[] @default([])
  note       String?  @db.VarChar(560)
  occurredAt DateTime @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)

  @@unique([userId, activityId])
  @@index([userId, hobbyId, occurredAt, id])
  @@map("progress_reflection")
}

// ADR-0024: minimal community profile used to enrich real-world activity decisions.
// hobbyId remains a logical cross-context reference to Catalog.
model Community {
  id          String                @id @db.Char(26)
  hobbyId     String                @db.Char(26)
  name        String                @db.VarChar(160)
  slug        String                @unique @db.VarChar(180)
  description String?               @db.Text
  city        String?               @db.VarChar(120)
  countryCode String?               @db.Char(2)
  status      CommunityStatus       @default(draft)
  memberships CommunityMembership[]
  createdAt   DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime              @updatedAt @db.Timestamptz(3)

  @@index([status, name, id])
  @@index([hobbyId, status])
  @@map("community")
}

// ADR-0024: durable relationship between one logical user reference and a Community.
// userId intentionally has no FK to Identity; Community owns only the membership lifecycle.
model CommunityMembership {
  id                  String                   @id @db.Char(26)
  communityId         String                   @db.Char(26)
  community           Community                @relation(fields: [communityId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  userId              String                   @db.Char(26)
  displayNameSnapshot String                   @db.VarChar(120)
  role                CommunityMembershipRole  @default(member)
  state               CommunityMembershipState @default(active)
  joinedAt            DateTime                 @db.Timestamptz(3)
  leftAt              DateTime?                @db.Timestamptz(3)
  createdAt           DateTime                 @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime                 @updatedAt @db.Timestamptz(3)

  @@unique([communityId, userId])
  @@index([userId, state, updatedAt])
  @@index([communityId, state, role])
  @@map("community_membership")
}

// ADR-0025: durable in-app prompts derived from Activity + commitment state.
// Cross-context user/activity references remain logical.
model CheckIn {
  id          String        @id @db.Char(26)
  userId      String        @db.Char(26)
  activityId  String        @db.Char(26)
  kind        CheckInKind
  status      CheckInStatus @default(pending)
  availableAt DateTime      @db.Timestamptz(3)
  actionedAt  DateTime?     @db.Timestamptz(3)
  dismissedAt DateTime?     @db.Timestamptz(3)
  createdAt   DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime      @updatedAt @db.Timestamptz(3)

  @@unique([userId, activityId, kind])
  @@index([userId, status, availableAt, id])
  @@map("check_in")
}

// Alpha activity history: something the user actually did. This is deliberately
// separate from Activity, which remains an opportunity/plan that may never happen.
// Cross-context identity, hobby and opportunity references are logical references.
model ActivityRecord {
  id                String   @id @db.Char(26)
  userId            String   @db.Char(26)
  hobbyId           String   @db.Char(26)
  opportunityId     String?  @db.Char(26)
  sportType         String   @db.VarChar(80)
  title             String   @db.VarChar(160)
  startedAt         DateTime @db.Timestamptz(3)
  durationSeconds   Int
  distanceMeters    Float?   @db.DoublePrecision
  notes             String?  @db.Text
  source            String   @db.VarChar(24)
  sourceReferenceId String?  @db.VarChar(80)
  externalUrl       String?  @db.Text
  visibility        String   @default("private") @db.VarChar(20)
  createdAt         DateTime @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime @updatedAt @db.Timestamptz(3)

  @@unique([userId, source, sourceReferenceId], map: "activity_record_external_source_key")
  @@index([userId, startedAt(sort: Desc), id], map: "activity_record_user_started_idx")
  @@index([hobbyId, startedAt(sort: Desc), id], map: "activity_record_hobby_started_idx")
  @@map("activity_record")
}

// Tokens are encrypted by the application before persistence. Strava is an
// optional integration and does not replace Wayfinder identity or manual records.
model StravaConnection {
  userId                 String    @id @db.Char(26)
  athleteId              String    @unique(map: "strava_connection_athlete_key") @db.VarChar(32)
  athleteDisplayName     String?   @db.VarChar(160)
  accessTokenCiphertext  String    @db.Text
  refreshTokenCiphertext String    @db.Text
  accessTokenExpiresAt   DateTime  @db.Timestamptz(3)
  scopes                 String[]  @default([])
  lastSyncedAt           DateTime? @db.Timestamptz(3)
  createdAt              DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt              DateTime  @updatedAt @db.Timestamptz(3)

  @@map("strava_connection")
}
