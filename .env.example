# Environment the app is running in: development | test | production
NODE_ENV=development

# HTTP port the Nest app listens on
PORT=3000

# Postgres connection string — matches docker-compose.yml's local credentials
DATABASE_URL=postgresql://hobbies:hobbies@localhost:5432/hobbies_dev

# Redis connection string for rate limiting/readiness. Local docker-compose
# exposes Redis on 6379. Production must set an explicit hosted value.
REDIS_URL=redis://localhost:6379

# Sentry is disabled when unset in development/test. Production requires the
# project DSN. Do not commit a real DSN or organization credential here.
SENTRY_DSN=
# Optional release label used to tie server errors to one deployed revision.
SENTRY_RELEASE=

# Pino log level: fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# HS256 signing secret for access JWTs (ADR-0017). Min 32 chars; generate
# with: openssl rand -base64 48. NEVER reuse this placeholder anywhere.
JWT_SECRET=local-dev-only-secret-change-me-0000000000

# Access JWT lifetime in seconds (default 900 = 15 min, ADR-0017)
ACCESS_TOKEN_TTL_SECONDS=900

# Refresh token lifetime in days (default 14, ADR-0017)
REFRESH_TOKEN_TTL_DAYS=14

# Comma-separated allowlist of browser origins allowed to call this API
# (security-guidelines.md: strict CORS allowlist). Leave unset/empty to
# block all cross-origin browser access (fail-closed default). Example for
# local Expo/mobile dev:
# CORS_ORIGINS=http://localhost:8081,http://localhost:19006
CORS_ORIGINS=

# Number of reverse-proxy hops whose X-Forwarded-* values are trusted.
# Keep 0 locally/direct. The Render Closed Alpha service uses exactly 1.
TRUST_PROXY_HOPS=0

# Explicit JSON/urlencoded request body ceiling. Allowed range: 16..1024 KB.
# 100 KB matches Express' default while making the security policy explicit.
REQUEST_BODY_LIMIT_KB=100
